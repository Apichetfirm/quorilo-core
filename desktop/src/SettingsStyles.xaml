<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Style TargetType="Button">
    <Setter Property="Foreground" Value="{DynamicResource SettingsTextBrush}"/>
    <Setter Property="Background" Value="{DynamicResource SettingsControlBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource SettingsBorderBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="FontSize" Value="14"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Padding" Value="16,9"/>
    <Setter Property="MinHeight" Value="44"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="HorizontalContentAlignment" Value="Center"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
      <Border x:Name="Chrome" CornerRadius="8" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" RecognizesAccessKey="True"/>
      </Border>
      <ControlTemplate.Triggers>
        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource SettingsAccentBrush}"/></Trigger>
        <Trigger Property="IsPressed" Value="True"><Setter TargetName="Chrome" Property="Opacity" Value="0.8"/></Trigger>
        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource SettingsTextBrush}"/><Setter TargetName="Chrome" Property="BorderThickness" Value="2"/></Trigger>
        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5"/></Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="SettingsPrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
    <Setter Property="Background" Value="{DynamicResource SettingsAccentBrush}"/>
    <Setter Property="Foreground" Value="{DynamicResource SettingsOnAccentBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource SettingsAccentBrush}"/>
  </Style>
  <Style TargetType="PasswordBox">
    <Setter Property="Foreground" Value="{DynamicResource SettingsTextBrush}"/>
    <Setter Property="Background" Value="{DynamicResource SettingsControlBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource SettingsBorderBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="PasswordBox">
      <Border x:Name="PasswordChrome" CornerRadius="8" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
        <ScrollViewer x:Name="PART_ContentHost"/>
      </Border>
      <ControlTemplate.Triggers><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="PasswordChrome" Property="BorderBrush" Value="{DynamicResource SettingsAccentBrush}"/></Trigger></ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="TabControl">
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabControl">
      <Grid KeyboardNavigation.TabNavigation="Local"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Border Background="{DynamicResource SettingsNavBrush}" CornerRadius="10" Padding="5" Margin="0,0,0,18">
          <TabPanel x:Name="HeaderPanel" IsItemsHost="True" KeyboardNavigation.TabIndex="1"/>
        </Border>
        <ContentPresenter x:Name="PART_SelectedContentHost" Grid.Row="1" ContentSource="SelectedContent"/>
      </Grid>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="TabItem">
    <Setter Property="Foreground" Value="{DynamicResource SettingsMutedBrush}"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Padding" Value="15,8"/>
    <Setter Property="MinHeight" Value="40"/>
    <!-- Keep spacing inside the template so TabPanel does not subtract the
         item's outer margin from the rounded highlight's layout width. -->
    <Setter Property="Margin" Value="0"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem">
      <Border x:Name="NavItem" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="7" Margin="0,0,4,0" Padding="{TemplateBinding Padding}">
        <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
      </Border>
      <ControlTemplate.Triggers>
        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="NavItem" Property="Background" Value="{DynamicResource SettingsControlBrush}"/></Trigger>
        <Trigger Property="IsSelected" Value="True"><Setter TargetName="NavItem" Property="Background" Value="{DynamicResource SettingsSelectedBrush}"/><Setter Property="Foreground" Value="{DynamicResource SettingsTextBrush}"/></Trigger>
        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="NavItem" Property="BorderBrush" Value="{DynamicResource SettingsAccentBrush}"/></Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="CheckBox">
    <Setter Property="Foreground" Value="{DynamicResource SettingsTextBrush}"/>
    <Setter Property="FontSize" Value="14"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox">
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border x:Name="Switch" Width="44" Height="26" CornerRadius="13" Background="{DynamicResource SettingsControlBrush}" BorderBrush="{DynamicResource SettingsBorderBrush}" BorderThickness="1" Margin="0,0,12,0" VerticalAlignment="Center">
          <Ellipse x:Name="Knob" Width="18" Height="18" Fill="{DynamicResource SettingsMutedBrush}" HorizontalAlignment="Left" Margin="3,0"/>
        </Border>
        <ContentPresenter Grid.Column="1" VerticalAlignment="Center" RecognizesAccessKey="True"/>
      </Grid>
      <ControlTemplate.Triggers>
        <Trigger Property="IsChecked" Value="True"><Setter TargetName="Switch" Property="Background" Value="{DynamicResource SettingsAccentBrush}"/><Setter TargetName="Switch" Property="BorderBrush" Value="{DynamicResource SettingsAccentBrush}"/><Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right"/><Setter TargetName="Knob" Property="Fill" Value="{DynamicResource SettingsOnAccentBrush}"/></Trigger>
        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Switch" Property="BorderBrush" Value="{DynamicResource SettingsTextBrush}"/><Setter TargetName="Switch" Property="BorderThickness" Value="2"/></Trigger>
        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5"/></Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="ComboBoxItem">
    <Setter Property="Foreground" Value="{DynamicResource SettingsTextBrush}"/>
    <Setter Property="Padding" Value="12,8"/>
    <Setter Property="MinHeight" Value="40"/>
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="SnapsToDevicePixels" Value="True"/>
    <Setter Property="FontSize" Value="14"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem">
      <Border x:Name="Item" Background="Transparent" CornerRadius="5" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" RecognizesAccessKey="True"/></Border>
      <ControlTemplate.Triggers>
        <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Item" Property="Background" Value="{DynamicResource SettingsSelectedBrush}"/></Trigger>
        <Trigger Property="IsSelected" Value="True"><Setter TargetName="Item" Property="Background" Value="{DynamicResource SettingsSelectedBrush}"/></Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="ComboBox">
    <Setter Property="Foreground" Value="{DynamicResource SettingsTextBrush}"/>
    <Setter Property="FontSize" Value="14"/>
    <Setter Property="MinHeight" Value="44"/>
    <Setter Property="Padding" Value="12,9"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox">
      <Grid>
        <Border x:Name="ComboChrome" CornerRadius="8" Background="{DynamicResource SettingsControlBrush}" BorderBrush="{DynamicResource SettingsBorderBrush}" BorderThickness="1"/>
        <ToggleButton Focusable="False" ClickMode="Press" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
          <ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border Background="Transparent"><Path Data="M 0 0 L 5 5 L 10 0" Stroke="{DynamicResource SettingsMutedBrush}" StrokeThickness="2" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,14,0"/></Border></ControlTemplate></ToggleButton.Template>
        </ToggleButton>
        <ContentPresenter IsHitTestVisible="False" Margin="12,9,38,9" VerticalAlignment="Center" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"/>
        <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" PlacementTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}" AllowsTransparency="True" Focusable="False" PopupAnimation="None">
          <Border Background="{DynamicResource SettingsPopupBrush}" BorderBrush="{DynamicResource SettingsBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="5" Margin="0,4,0,0" SnapsToDevicePixels="True" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
            <ScrollViewer MaxHeight="280" CanContentScroll="False" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"><ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/></ScrollViewer>
          </Border>
        </Popup>
      </Grid>
      <ControlTemplate.Triggers>
        <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="ComboChrome" Property="BorderBrush" Value="{DynamicResource SettingsAccentBrush}"/></Trigger>
        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ComboChrome" Property="BorderBrush" Value="{DynamicResource SettingsAccentBrush}"/></Trigger>
        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5"/></Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="SettingsScrollPage" TargetType="RepeatButton">
    <Setter Property="Focusable" Value="False"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="ScrollBar">
    <Setter Property="Width" Value="10"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar">
      <Grid Background="Transparent">
        <Track x:Name="PART_Track" Orientation="{TemplateBinding Orientation}" IsDirectionReversed="True">
          <Track.DecreaseRepeatButton><RepeatButton Command="{x:Static ScrollBar.PageUpCommand}" Style="{StaticResource SettingsScrollPage}"/></Track.DecreaseRepeatButton>
          <Track.Thumb><Thumb MinHeight="24"><Thumb.Template><ControlTemplate TargetType="Thumb"><Border x:Name="Grip" CornerRadius="4" Margin="2,0" Background="{DynamicResource SettingsBorderBrush}"/><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Grip" Property="Background" Value="{DynamicResource SettingsAccentBrush}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
          <Track.IncreaseRepeatButton><RepeatButton Command="{x:Static ScrollBar.PageDownCommand}" Style="{StaticResource SettingsScrollPage}"/></Track.IncreaseRepeatButton>
        </Track>
      </Grid>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="SettingsSliderTrack" TargetType="RepeatButton">
    <Setter Property="Focusable" Value="False"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RepeatButton"><Border Background="{TemplateBinding Background}" Height="6" CornerRadius="3"/></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="Slider">
    <Setter Property="MinHeight" Value="34"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Slider">
      <Grid Background="Transparent" Margin="8,0">
        <Track x:Name="PART_Track" VerticalAlignment="Center" IsDirectionReversed="{TemplateBinding IsDirectionReversed}">
          <Track.DecreaseRepeatButton><RepeatButton Command="{x:Static Slider.DecreaseLarge}" Style="{StaticResource SettingsSliderTrack}" Background="{DynamicResource SettingsAccentBrush}"/></Track.DecreaseRepeatButton>
          <Track.Thumb><Thumb Width="22" Height="22"><Thumb.Template><ControlTemplate TargetType="Thumb"><Ellipse Fill="{DynamicResource SettingsAccentBrush}" Stroke="{DynamicResource SettingsCardBrush}" StrokeThickness="3"/></ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
          <Track.IncreaseRepeatButton><RepeatButton Command="{x:Static Slider.IncreaseLarge}" Style="{StaticResource SettingsSliderTrack}" Background="{DynamicResource SettingsBorderBrush}"/></Track.IncreaseRepeatButton>
        </Track>
        <Border x:Name="SliderFocus" BorderThickness="1" BorderBrush="Transparent" CornerRadius="6" IsHitTestVisible="False"/>
      </Grid>
      <ControlTemplate.Triggers><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="SliderFocus" Property="BorderBrush" Value="{DynamicResource SettingsAccentBrush}"/></Trigger></ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
</ResourceDictionary>
